# Copie para .env ou execute ./scripts/bootstrap.sh.
PROJECTS_DIR=/home/seu-usuario/projetos
RUNTIME_HOME_DIR=/home/seu-usuario/.local/share/dsh-orchestrator/home
ORCHESTRATOR_TOKEN=troque-por-um-token-aleatorio-longo
DSH_HOST_PORT=9080
ORCHESTRATOR_HOST_PORT=3000
RUNTIME_UID=1000
RUNTIME_GID=1000

# DSH / OpenRouter (opcional; configure com ./scripts/configure-openrouter.sh)
OPENROUTER_API_KEY=

# Opcional: sobrescreva os modelos usados no settings.yaml inicial do DSH.
DSH_OPENROUTER_MODEL=openrouter/auto
DSH_OLLAMA_MODEL=qwen3-coder:30b

# Atualização de segurança SEM recompilar do zero (23/10/2026, caso eMudhra).
# Um `docker compose build --pull` puxa versões novas dos plugins @deepseek-ai/cordis-*
# (sem trava) e o dsh para de subir ("requires the Cordis HMR service").
# Esta camada parte da imagem que funciona e troca só o Node e a lista de certificados.
# Uso (backup antes: docker tag dsh-orchestrator-runtime:latest dsh-orchestrator-runtime:pre-update):
#   docker tag dsh-orchestrator-runtime:latest dsh-orchestrator-runtime:pre-emudhra   # base desta camada
#   docker build -t dsh-orchestrator-runtime:latest -f docker/Dockerfile.seguranca docker/
#   docker compose -f compose.yaml up -d && ./scripts/status.sh
FROM node:22-bookworm-slim AS novo
FROM dsh-orchestrator-runtime:pre-emudhra
USER root
COPY --from=novo /usr/local/bin/node /usr/local/bin/node
RUN apt-get update -qq && apt-get install -y -qq --only-upgrade ca-certificates >/dev/null && apt-get clean
USER agent
